# Copy to .env (or export these as real environment variables) before running.

PORT=5000

# MongoDB connection string - same database the MERN backend used
MONGODB_URI=mongodb://localhost:27017/traffic_fine_system

# JWT
JWT_SECRET=change-this-super-secret-key-in-production-please
JWT_EXPIRE_MS=604800000

# CORS - "*" allows all origins, or a comma-separated list
CORS_ORIGIN=*

# Set to true once (or leave true) to seed demo categories + users on startup
SEED_ON_STARTUP=false

# Where the built React frontend lives, if you want Spring Boot to serve it
FRONTEND_BUILD_PATH=../frontend/build

# Twilio (optional - omit to fall back to mock/logged SMS, same as the original app)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
